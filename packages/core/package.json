{
  "name": "@paper-market/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./market": {
      "types": "./dist/market/symbol-normalization.d.ts",
      "default": "./dist/market/symbol-normalization.js"
    },
    "./trading": {
      "types": "./dist/trading/order.types.d.ts",
      "default": "./dist/trading/order.types.js"
    },
    "./validation": {
      "types": "./dist/validation/oms.d.ts",
      "default": "./dist/validation/oms.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "pg": "^8.17.2",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.16.0",
    "typescript": "^5.8.3"
  }
}
