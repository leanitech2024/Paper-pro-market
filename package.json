{
  "name": "@paper-market/root",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "web": "pnpm --filter @paper-market/web dev",
    "engine": "pnpm --filter @paper-market/market-engine dev",
    "migrate:reconcile": "tsx scripts/reconcile-drizzle-migrations.ts",
    "proto:json": "node -e \"const {execSync}=require('child_process'); const fs=require('fs'); const out=execSync('npx -p protobufjs-cli pbjs -t json public/proto/MarketDataFeedV3.proto',{encoding:'utf8'}); fs.writeFileSync('lib/integrations/upstox/proto.json', out, 'utf8');\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.1.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "knip": "^6.2.0",
    "turbo": "^2.8.20",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
