{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @paper-market/core build && pnpm --filter @paper-market/market-engine build"
  },
  "deploy": {
    "startCommand": "node apps/market-engine/dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}